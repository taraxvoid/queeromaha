{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "numberOfRuns": 1,
            "url": ["/", "/friends", "/friends/o4us"],
            "settings": {
                "onlyCategories": ["seo", "performance"],
                "emulatedFormFactor": "mobile"
            }
        },
        "assert": {
            "assertions": {
                "categories:seo": ["warn", { "minScore": 0.8 }],
                "document-title": "error",
                "meta-description": "warn",
                "is-crawlable": ["warn", { "minScore": 0.9 }],
                "crawlable-anchors": ["warn", { "minScore": 0.9 }],
                "http-status-code": ["warn", { "minScore": 0.9 }],
                "link-text": ["warn", { "minScore": 0.9 }],
                "hreflang": ["warn", { "minScore": 0.9 }],
                "canonical": ["warn", { "minScore": 0.9 }],
                "categories:performance": ["warn", { "minScore": 0.9 }],
                "largest-contentful-paint": [
                    "warn",
                    { "maxNumericValue": 2500 }
                ],
                "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
                "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
                "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }]
            }
        }
    }
}
