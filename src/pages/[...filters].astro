---
import FilterBar from '../components/FilterBar.astro'
import ItemCard from '../components/ItemCard.astro'
import site from '../data/site.json'
import Base from '../layouts/Base.astro'
import { computeItemSlugs } from '../utils/itemSlug'
import { toJsonLdScript } from '../utils/jsonLd'
import {
    categoryMap,
    getFilterStaticPaths,
    resolveFilters,
} from '../utils/resolveFilters'

export async function getStaticPaths() {
    const paths = await getFilterStaticPaths()
    return paths.map((filters) => ({ params: { filters } }))
}

const { filters = '' } = Astro.params
const {
    entries,
    initialCategories,
    matchesInitial,
    activeCategoryHasFilters,
    initialItemSlug,
    pageTitle,
    pageDescription,
} = await resolveFilters(filters)

// Ties the per-item Organization JSON-LD blocks (emitted by ItemCard) together
// as "this page lists these entities" — crawlers otherwise see a pile of
// disconnected Organization blocks with no listing structure.
const visibleItemListElements = entries.flatMap((entry) => {
    if (!matchesInitial(entry.id)) return []
    const publicItems = (entry.data.items ?? []).filter(
        (i) => i.public !== false,
    )
    const itemSlugs = computeItemSlugs(publicItems)
    return publicItems.map((item, i) => ({
        name: item.name,
        url: new URL(`/${entry.id}/${itemSlugs[i].canonical}`, site.url).href,
    }))
})
const itemListJsonLdStr = toJsonLdScript({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: visibleItemListElements.map((el, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: el.url,
        name: el.name,
    })),
})
---

<Base
  title={pageTitle}
  description={pageDescription}
  initialCategories={initialCategories}
  initialItemSlug={initialItemSlug}
>
  <script is:inline type="application/ld+json" set:html={itemListJsonLdStr} />
  {activeCategoryHasFilters && <FilterBar />}
  {entries.map(entry => {
    const publicItems = (entry.data.items ?? []).filter(i => i.public !== false)
    if (publicItems.length === 0) return null
    const anyVisible = matchesInitial(entry.id)
    const itemSlugs = computeItemSlugs(publicItems)
    return (
      <section id={`section-${entry.id}`} aria-label={categoryMap[entry.id]?.label ?? entry.id}>
        <h2 class:list={['section-header', { 'is-hidden': !anyVisible }]} data-category-heading={entry.id}>
          <wa-icon name={categoryMap[entry.id]?.icon} aria-hidden="true"></wa-icon> {categoryMap[entry.id]?.label ?? entry.id}
        </h2>
        {publicItems.map((item, i) => (
          <ItemCard item={item} category={entry.id} slug={itemSlugs[i].canonical} hidden={!matchesInitial(entry.id)} />
        ))}
      </section>
    )
  })}
</Base>
