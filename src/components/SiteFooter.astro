---
import CalendarBox from './CalendarBox.astro'
---

<footer class="site-footer">
  <details class="suggestion-box" id="suggestionBox" name="footer-accordion">
    <summary class="footer-pill-btn">
      <wa-icon
        name="lightbulb"
        variant="regular"
        aria-hidden="true"
        style="font-size: 1.25em;"></wa-icon>
      Suggestion Box
    </summary>
    <div class="suggestion-box-panel-wrap">
      <div class="suggestion-box-panel">
        <form
          id="suggestForm"
          name="suggest"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
        >
          <p class="suggestion-honeypot">
            <label
              >Don't fill this out if you're human: <input
                name="bot-field"
              /></label
            >
          </p>
          <label class="suggestion-label" for="suggestionMessage">
            What would you like to add or edit?
          </label>
          <input
            id="suggestionMessage"
            class="suggestion-input"
            type="text"
            name="message"
            required
            maxlength="140"
            enterkeyhint="send"
            aria-describedby="suggestionHint"
            placeholder="Your cool group, venue, event"
          />
          <p class="suggestion-hint" id="suggestionHint">
            Up to 140 characters
          </p>
        </form>
      </div>
      <div class="suggestion-box-toggle-row">
        <button class="suggestion-submit" type="submit" form="suggestForm">
          <wa-icon
            name="paper-plane"
            variant="regular"
            aria-hidden="true"
            style="font-size: 1.5em;"></wa-icon>
          Send
        </button>
      </div>
    </div>
  </details>
  <CalendarBox />
  <span class="footer-separator footer-separator-left" aria-hidden="true"
  ></span>
  <span class="footer-separator footer-separator-right" aria-hidden="true"
  ></span>
  <nav class="footer-nav" aria-label="Footer navigation">
    <details class="utility-box" id="utilityBox" name="footer-accordion">
      <summary
        class="footer-pill-btn"
        aria-label="Utility Links (Privacy, Contact, GitHub)"
      >
        <wa-icon name="wrench" aria-hidden="true" style="font-size: 1.4em;"
        ></wa-icon>
      </summary>
      <div class="utility-box-panel">
        <a
          class="utility-option"
          href="https://github.com/taraxvoid/queeromaha"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="@taraxvoid/queeromaha on GitHub (opens in new tab)"
        >
          <wa-icon family="brands" name="github" aria-hidden="true"
          ></wa-icon>GitHub
        </a>
        <a class="utility-option" href="/privacy">
          <wa-icon name="circle-info" variant="solid" aria-hidden="true"
          ></wa-icon>
          Privacy
        </a>
        <a class="utility-option" href="/contact">
          <wa-icon name="envelope" variant="regular" aria-hidden="true"
          ></wa-icon>
          Contact
        </a>
      </div>
    </details>
  </nav>
</footer>

<script>
  import "../scripts/suggestionBox";
  import "../scripts/footerAccordionOverlay";
</script>
