---
import type { CollectionEntry } from 'astro:content'
import type { Organization, PostalAddress, WithContext } from 'schema-dts'
import LD from '#components/LD.astro'
import tagMap from '#data/tagMap.json'
import { resolveLink } from '#utils/linkRules.ts'
import { formatLocationLine, mapsUrl } from '#utils/location.ts'
import EntryTag from './EntryTag.astro'

type TagMap = Record<string, { icon: string; label: string; family?: string }>
const tags = tagMap as TagMap
const tagOrder = Object.keys(tags)

interface Props {
    item: Required<CollectionEntry<'directory'>['data']>['items'][0]
    category: string
    slug: string
    hidden?: boolean
}

const { item, category, slug, hidden = false } = Astro.props
const tagsAttr = item.tags?.join(' ') ?? ''

const loc = item.location
const locLine = formatLocationLine(loc)
const mapHref = mapsUrl(loc)

// Per-item structured data. As of 2026 schema.org markup — not llms.txt — is
// what assistants and answer engines actually read when deciding which local
// entities to surface. We emit Organization (the truthful supertype across
// support groups, venues, and cafes alike) rather than LocalBusiness, which
// would assert a "this is a business" claim we can't verify for every entry.
const itemLinks = item.links?.map((l) => l.url) ?? []
const postalAddress =
    loc?.street || loc?.city || loc?.state || loc?.zip
        ? ({
              '@type': 'PostalAddress',
              ...(loc?.street && { streetAddress: loc.street }),
              ...(loc?.city && { addressLocality: loc.city }),
              ...(loc?.state && { addressRegion: loc.state }),
              ...(loc?.zip && { postalCode: loc.zip }),
          } satisfies PostalAddress)
        : undefined
const plainDesc = item.description?.replace(/\s+/g, ' ').trim() ?? ''
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: item.name,
    ...(plainDesc && { description: plainDesc }),
    ...(itemLinks.length > 0 && { sameAs: itemLinks }),
    ...(postalAddress && { address: postalAddress }),
    ...(loc?.google_maps_url && { hasMap: loc.google_maps_url }),
} satisfies WithContext<Organization>
---

<LD data={jsonLd} />
<wa-card
  class:list={["item", { "is-hidden": hidden }]}
  id={`${category}-${slug}`}
  data-category={category}
  data-slug={slug}
  data-tags={tagsAttr}
>
  <h3 slot="header">
    <button type="button" class="item-tap-target" aria-pressed="false"
      >{item.name}</button
    >
    {
      [...(item.tags ?? [])]
        .sort((a, b) => tagOrder.indexOf(a) - tagOrder.indexOf(b))
        .map((tag) => {
          const t = tags[tag];
          return t ? (
            <EntryTag label={t.label} icon={t.icon} family={t.family} />
          ) : null;
        })
    }
  </h3>
  {item.description && <p>{item.description}</p>}
  {
    loc && locLine && (
      <p class="item-location">
        <wa-icon name="location-dot" aria-hidden="true" />
        {mapHref ? (
          <a
            href={mapHref}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`Map: ${locLine} (opens in new tab)`}
          >
            {locLine}
          </a>
        ) : (
          locLine
        )}
      </p>
    )
  }
  {
    item.links && item.links.length > 0 && (
      <ul class="entry-links" slot="footer">
        {[...item.links]
          .map((link) => ({ link, resolved: resolveLink(link) }))
          .sort((a, b) => a.resolved.rank - b.resolved.rank)
          .map(({ link, resolved }) => {
            const pillIcon = resolved.icon;
            return (
              <li>
                <a
                  href={link.url}
                  rel="noopener"
                  target="_blank"
                  aria-label={`${link.label} (opens in new tab)`}
                  data-ph-item-name={item.name}
                  data-ph-item-category={category}
                  data-ph-link-label={link.label}
                >
                  {pillIcon && (
                    <wa-icon
                      name={pillIcon.name}
                      family={pillIcon.family}
                      aria-hidden="true"
                    />
                  )}
                  {link.label}
                </a>
              </li>
            );
          })}
      </ul>
    )
  }
</wa-card>

<style>
  .item-location {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    font-family: var(--font-mono);
    color: #7c3aed;
  }

  .item-location a {
    text-decoration: dotted underline;
    &,
    &:hover,
    &:focus {
      color: #7c3aed;
      border-bottom-color: transparent;
    }
    &:hover,
    &:focus {
      text-decoration-style: solid;
    }
  }

  @media (prefers-color-scheme: dark) {
    .item-location,
    .item-location a {
      color: var(--dm-glow);
    }
  }
</style>
