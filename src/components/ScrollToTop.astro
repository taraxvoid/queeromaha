<button
  id="backToTop"
  class="back-to-top"
  type="button"
  aria-label="Back to top"
>
  <wa-icon
    class="icon"
    name="circle-arrow-up"
    variant="solid"
    aria-hidden="true"></wa-icon>
</button>

<script>
  import { prefersReducedMotion } from "#utils/motion.ts";

  const backToTopButton = document.getElementById("backToTop");
  const header = document.querySelector<HTMLElement>(".site-header");
  if (backToTopButton && header) {
    window.addEventListener(
      "scroll",
      () => {
        backToTopButton.classList.toggle(
          "show",
          window.scrollY > header.offsetHeight,
        );
      },
      { passive: true },
    );
    backToTopButton.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: prefersReducedMotion() ? "instant" : "smooth",
      });
    });
  }
</script>

<style>
  /* Back to top button */
  .back-to-top {
    position: fixed;
    bottom: 5.5rem;
    right: 2rem;
    background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    font-size: 1.5rem;
    cursor: pointer;
    box-shadow:
      0 4px 12px rgba(109, 40, 217, 0.4),
      inset 1px 1px 3px rgba(255, 255, 255, 0.4),
      inset -1px -1px 3px rgba(0, 0, 0, 0.2);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0.3s,
      transform 0.2s,
      background-color 0.2s;
    z-index: 1000;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;

    &.show {
      opacity: 1;
      visibility: visible;
    }

    &:hover,
    &:focus {
      background: linear-gradient(135deg, #c084fc 0%, #a855f7 100%);
      transform: translateY(-2px);
      box-shadow:
        0 6px 16px rgba(109, 40, 217, 0.5),
        inset 1px 1px 3px rgba(255, 255, 255, 0.4),
        inset -1px -1px 3px rgba(0, 0, 0, 0.2);
    }
  }

  .icon {
    font-size: 1.8rem;
  }

  /* Hide alongside the other footer buttons while the suggestion box or
   calendar box is open (theme.css's [open] ~ .footer-* rules can't reach
   this far since #backToTop is a sibling of <footer>, not nested
   inside it — :has() is the only way to reach across that boundary). */
  :global(body:has(.site-footer [open])) .back-to-top {
    display: none;
  }
</style>
