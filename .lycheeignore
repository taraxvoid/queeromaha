# .lycheeignore — regex patterns (one per line). A URL is skipped if any line
# matches it as a regular expression. Mirrors the SKIP_DOMAINS + bot-handling
# intent of the old scripts/check-links.js (which skipped these hosts entirely
# because of 403 bot-blocks / 200-body shadow-bans).
#
# NOTE: lychee cannot inspect response *bodies*, so shadow-ban detection (a 200
# with "this page isn't available") is lost for x.com/twitter — a deleted
# account there will just pass instead of being flagged. 404s are still caught.
# Keep host patterns anchored to the host + path-boundary so 'x.com' can't match
# unrelated hosts like 'fix.com'.

# Social / bot-hosts that don't reliably respond to automated requests
https?://([^/]+\.)*facebook\.com(/|$)
https?://([^/]+\.)*fb\.com(/|$)
https?://([^/]+\.)*linkedin\.com(/|$)
https?://([^/]+\.)*instagram\.com(/|$)
https?://([^/]+\.)*x\.com(/|$)
https?://([^/]+\.)*twitter\.com(/|$)

# Small/local orgs the old script also skipped (flaky or bot-blocked)
https?://([^/]+\.)*synthomaha\.net(/|$)
https?://([^/]+\.)*soundryomaha\.org(/|$)
https?://([^/]+\.)*fifthhouseomaha\.com(/|$)
